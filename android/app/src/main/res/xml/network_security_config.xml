<?xml version="1.0" encoding="utf-8"?>
<!-- 允许明文访问局域网桥接（http 8889），并信任用户安装的本地 CA（https 8888 自签证书） -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
